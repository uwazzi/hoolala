{
  "name": "hoolala",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hoolala! Signals here. People who share a place post small invitations to talk and meet in person.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "eval": "node evals/run.mjs",
    "dev": "wrangler dev --infer-origin-from-routes=false",
    "db:migrate": "wrangler d1 migrations apply hoolala --remote",
    "db:migrate:local": "wrangler d1 migrations apply hoolala --local",
    "db:migrate:staging": "wrangler d1 migrations apply hoolala-staging --remote -c wrangler.staging.toml",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build && wrangler deploy -c wrangler.staging.toml",
    "build": "vite build web",
    "dev:web": "vite web",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vitest": "^2.1.0",
    "wrangler": "^4.154.0"
  },
  "dependencies": {
    "preact": "^11.1.0",
    "preact-iso": "^2.12.2"
  }
}
